# Copernicus Data Space Ecosystem / Sentinel Hub credentials
# Get free account at: https://dataspace.copernicus.eu/
COPEERNICUS_USERNAME=your_username
COPEERNICUS_PASSWORD=your_password

# Alternative: Sentinel Hub API (free tier available)
# Get credentials at: https://www.sentinel-hub.com/products/stac-api
SENTINEL_HUB_CLIENT_ID=your_client_id
SENTINEL_HUB_CLIENT_SECRET=your_client_secret

# Database configuration
POSTGRES_USER=flood_user
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_DB=flood_prediction
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Application settings
APP_ENV=development
SECRET_KEY=change_this_to_a_random_secret_key_in_production
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File storage
DATA_DIR=/app/data
MAX_AOI_SIZE_KM2=100
MAX_DOWNLOAD_SIZE_MB=500

# Processing settings
DEFAULT_BACKSCATTER_THRESHOLD=-20
DEFAULT_NDWI_THRESHOLD=0.3
DEFAULT_MNDWI_THRESHOLD=0.0
MIN_CONNECTED_COMPONENT_SIZE=100

# External APIs (optional)
# NASA Earthdata for DEM and rainfall (free account required)
# Register at: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_USERNAME=your_earthdata_username
NASA_EARTHDATA_PASSWORD=your_earthdata_password

# OpenWeatherMap for rainfall data (free tier available)
# Get API key at: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# Map tiles (optional - MapLibre uses free OSM by default)
MAPBOX_ACCESS_TOKEN=

# Celery settings
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
